<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>“私兔欢乐跑”隐私政策声明</title>
    <!-- 引入 Google Fonts 现代字体 -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        /* 核心设计系统变量 */
        :root {
            --primary: #00E5FF; /* rrCyan 蓝绿色 */
            --primary-hover: #00B8D4;
            --primary-glow: rgba(0, 229, 255, 0.15);
            --bg-start: #0B0F19; /* 高级深色渐变起点 */
            --bg-end: #1E293B;   /* 渐变终点 */
            --card-bg: rgba(30, 41, 59, 0.7);
            --card-border: rgba(255, 255, 255, 0.08);
            --text-main: #F8FAFC;
            --text-muted: #94A3B8;
            --text-accent: #00E5FF;
            --sidebar-width: 280px;
            --transition-smooth: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        /* 基础样式重置与排版 */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
            font-size: 16px;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            background: linear-gradient(135deg, var(--bg-start), var(--bg-end));
            background-attachment: fixed;
            color: var(--text-main);
            line-height: 1.7;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            min-height: 100vh;
        }

        /* 网页整体布局结构 */
        .app-container {
            display: flex;
            max-width: 1200px;
            margin: 0 auto;
            padding: 40px 20px;
            gap: 40px;
        }

        /* 左侧固定侧边栏 */
        .sidebar {
            width: var(--sidebar-width);
            flex-shrink: 0;
            position: sticky;
            top: 40px;
            height: calc(100vh - 80px);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .brand-container {
            margin-bottom: 24px;
        }

        .brand-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 700;
            font-size: 1.25rem;
            color: var(--text-main);
            text-decoration: none;
        }

        .logo-icon {
            width: 32px;
            height: 32px;
            background: linear-gradient(135deg, var(--primary), #00B0FF);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 12px var(--primary-glow);
        }

        .logo-icon svg {
            width: 20px;
            height: 20px;
            fill: #0F172A;
        }

        .toc-list {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 8px;
            overflow-y: auto;
            padding-right: 10px;
        }

        /* 自定义滚动条 */
        .toc-list::-webkit-scrollbar {
            width: 4px;
        }
        .toc-list::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 2px;
        }

        .toc-item a {
            display: block;
            padding: 8px 16px;
            color: var(--text-muted);
            text-decoration: none;
            border-left: 2px solid rgba(255, 255, 255, 0.05);
            font-size: 0.9rem;
            font-weight: 500;
            transition: var(--transition-smooth);
        }

        .toc-item a:hover, .toc-item.active a {
            color: var(--primary);
            border-left-color: var(--primary);
            background: rgba(0, 229, 255, 0.04);
            padding-left: 20px;
        }

        .sidebar-footer {
            margin-top: 24px;
            font-size: 0.75rem;
            color: var(--text-muted);
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            padding-top: 16px;
        }

        /* 右侧主要内容区域 */
        .main-content {
            flex-grow: 1;
            min-width: 0; /* 防止 Flex 项目溢出 */
        }

        /* 顶部卡片：标题与说明 */
        .header-card {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 24px;
            padding: 40px;
            margin-bottom: 30px;
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
            position: relative;
            overflow: hidden;
        }

        .header-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: linear-gradient(90deg, var(--primary), #00E5FF, #00B0FF);
        }

        .app-badge {
            display: inline-flex;
            align-items: center;
            background: rgba(0, 229, 255, 0.1);
            color: var(--primary);
            padding: 4px 12px;
            border-radius: 100px;
            font-size: 0.8rem;
            font-weight: 600;
            margin-bottom: 16px;
            border: 1px solid rgba(0, 229, 255, 0.15);
        }

        h1 {
            font-size: 2.25rem;
            font-weight: 700;
            letter-spacing: -0.025em;
            margin-bottom: 12px;
            background: linear-gradient(to right, #FFFFFF, #E2E8F0);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .meta-info {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-top: 16px;
        }

        .meta-item {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        /* 隐私政策章节卡片 */
        .section-card {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 20px;
            padding: 32px;
            margin-bottom: 24px;
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            transition: var(--transition-smooth);
        }

        .section-card:hover {
            border-color: rgba(0, 229, 255, 0.2);
            box-shadow: 0 10px 30px rgba(0, 229, 255, 0.03);
        }

        /* 章节标题 */
        h2 {
            font-size: 1.35rem;
            font-weight: 600;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 12px;
            color: var(--text-main);
        }

        h2::before {
            content: '';
            display: block;
            width: 4px;
            height: 18px;
            background: var(--primary);
            border-radius: 2px;
            box-shadow: 0 0 8px var(--primary);
        }

        p {
            color: #CBD5E1;
            margin-bottom: 16px;
            font-size: 0.95rem;
        }

        /* HealthKit 专属突出显示框 */
        .highlight-box {
            background: rgba(0, 229, 255, 0.03);
            border: 1.5px dashed rgba(0, 229, 255, 0.3);
            border-radius: 12px;
            padding: 24px;
            margin: 20px 0;
            position: relative;
        }

        .highlight-box h3 {
            color: var(--primary);
            font-size: 1.05rem;
            font-weight: 600;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .highlight-box strong {
            color: #FFFFFF;
            background: linear-gradient(120deg, rgba(0, 229, 255, 0.15) 0%, rgba(0, 229, 255, 0.05) 100%);
            padding: 2px 6px;
            border-radius: 4px;
        }

        /* 列表样式 */
        .bullet-list {
            list-style: none;
            margin-bottom: 16px;
        }

        .bullet-list li {
            position: relative;
            padding-left: 24px;
            margin-bottom: 10px;
            color: #CBD5E1;
            font-size: 0.95rem;
        }

        .bullet-list li::before {
            content: "•";
            position: absolute;
            left: 8px;
            color: var(--primary);
            font-weight: bold;
            font-size: 1.1rem;
        }

        /* 权限对照表格 */
        .permission-table-wrapper {
            overflow-x: auto;
            border-radius: 12px;
            border: 1px solid var(--card-border);
            margin: 20px 0 10px 0;
        }

        .permission-table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
            font-size: 0.9rem;
        }

        .permission-table th, .permission-table td {
            padding: 14px 18px;
            border-bottom: 1px solid var(--card-border);
        }

        .permission-table th {
            background: rgba(255, 255, 255, 0.03);
            font-weight: 600;
            color: var(--text-main);
        }

        .permission-table td {
            color: #CBD5E1;
        }

        .permission-table tr:last-child td {
            border-bottom: none;
        }

        .permission-badge {
            background: rgba(255, 255, 255, 0.06);
            padding: 4px 10px;
            border-radius: 6px;
            font-family: monospace;
            font-size: 0.8rem;
            color: var(--text-main);
            border: 1px solid rgba(255, 255, 255, 0.04);
        }

        /* 链接按钮样式 */
        .link-button {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: var(--primary);
            text-decoration: none;
            font-weight: 500;
            font-size: 0.9rem;
            margin-top: 8px;
            padding: 6px 12px;
            border-radius: 6px;
            background: rgba(0, 229, 255, 0.05);
            border: 1px solid rgba(0, 229, 255, 0.1);
            transition: var(--transition-smooth);
        }

        .link-button:hover {
            color: #FFFFFF;
            background: var(--primary);
            box-shadow: 0 0 12px rgba(0, 229, 255, 0.4);
            border-color: var(--primary);
            transform: translateY(-1px);
        }

        .link-button svg {
            width: 14px;
            height: 14px;
            stroke: currentColor;
            fill: none;
            stroke-width: 2;
        }

        .small-note {
            display: block;
            font-size: 0.75rem;
            color: var(--text-muted);
            margin-top: 6px;
        }

        /* 响应式媒体查询 */
        @media (max-width: 1024px) {
            .app-container {
                flex-direction: column;
                padding: 20px;
            }

            .sidebar {
                width: 100%;
                position: relative;
                top: 0;
                height: auto;
                margin-bottom: 20px;
            }

            .toc-list {
                flex-direction: row;
                overflow-x: auto;
                padding-bottom: 8px;
                white-space: nowrap;
            }

            .toc-item a {
                border-left: none;
                border-bottom: 2px solid transparent;
                padding: 8px 12px;
            }

            .toc-item a:hover, .toc-item.active a {
                border-left-color: transparent;
                border-bottom-color: var(--primary);
                padding-left: 12px;
            }

            .sidebar-footer {
                display: none;
            }
        }

        @media (max-width: 640px) {
            .header-card {
                padding: 24px;
            }

            .section-card {
                padding: 24px;
            }

            h1 {
                font-size: 1.75rem;
            }

            .permission-table th, .permission-table td {
                padding: 10px 12px;
                font-size: 0.85rem;
            }
        }
    </style>
</head>
